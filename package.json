{
  "name": "stellar-solana-escrow",
  "private": true,
  "scripts": {
    "chain:stellar": "bash blockchains/stellar/scripts/start-network.sh",
    "chain:stellar:stop": "bash blockchains/stellar/scripts/stop-network.sh",
    "chain:stellar:faucet": "npx tsx blockchains/stellar/scripts/faucet.ts",
    "chain:stellar:deploy": "soroban contract deploy --source deployer --wasm target/wasm32v1-none/release/escrow.wasm --network local",
    "chain:stellar:deploy:testnet": "bash blockchains/stellar/scripts/deploy-testnet.sh",
    "chain:stellar:sac:testnet": "npx tsx blockchains/stellar/scripts/create-testnet-sac.ts",
    "chain:solana": "bash blockchains/solana/scripts/start-validator.sh",
    "chain:solana:stop": "bash blockchains/solana/scripts/stop-validator.sh",
    "chain:solana:faucet": "npx tsx blockchains/solana/scripts/faucet.ts",
    "chain:solana:deploy": "cd blockchains/solana && anchor deploy",
    "chain:solana:deploy:devnet": "bash blockchains/solana/scripts/deploy-devnet.sh",
    "chain:solana:mint:devnet": "npx tsx blockchains/solana/scripts/create-devnet-mint.ts",
    "chain:health": "npx tsx blockchains/scripts/health-check.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1"
  }
}